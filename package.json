{
  "name": "aureus-protocol",
  "version": "1.0.0",
  "description": "AUREUS PROTOCOL (AUREUS OS) — Sovereign Financial Operating System & Integrity Cockpit for Disciplined Traders (MT4/MT5 Journal, Backtesting Replay, Pre-Trade Circuit Breaker)",
  "homepage": "https://aureus-os.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/GarikVolegov/TraderLoading.git"
  },
  "keywords": [
    "trading-journal",
    "tradezella-alternative",
    "edgewonk-alternative",
    "tradersync-alternative",
    "fxreplay-alternative",
    "backtesting",
    "tradingview-alternative",
    "metatrader5",
    "metatrader4",
    "trading-psychology",
    "prop-firm",
    "forex-trading"
  ],
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('node:fs'); for (const file of ['package-lock.json','yarn.lock']) fs.rmSync(file,{force:true}); const ua=process.env.npm_config_user_agent||''; const execPath=process.env.npm_execpath||''; if (!ua.startsWith('pnpm/') && !execPath.includes('pnpm')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "pnpm --filter ./scripts exec tsx local/typecheck.ts",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 39",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter ./scripts exec tsx local/run-tests.ts",
    "verify": "pnpm --filter ./scripts exec tsx local/verify.ts",
    "verify:runtime": "pnpm --filter ./scripts exec tsx local/verify-runtime.ts",
    "smoke:runtime": "pnpm --filter ./scripts exec tsx local/runtime-smoke.ts",
    "preflight": "pnpm --filter ./scripts exec tsx local/productionPreflight.ts",
    "start:local": "pnpm --filter ./scripts exec tsx local/start.ts",
    "release:local": "pnpm --filter ./scripts exec tsx local/release.ts",
    "backtest:sync": "pnpm --filter ./scripts exec tsx local/backtestHistory.ts seed",
    "backtest:bulk": "pnpm --filter ./scripts exec tsx local/bulkSync.ts",
    "backtest:tail": "pnpm --filter ./scripts exec tsx local/backtestHistory.ts tail",
    "backtest:import": "pnpm --filter ./scripts exec tsx local/backtestHistory.ts import",
    "build:sitemap": "pnpm --filter @workspace/trader-dashboard run build:sitemap",
    "indexnow": "pnpm --filter @workspace/trader-dashboard run indexnow",
    "build:railway": "pnpm --filter @workspace/trader-dashboard build && pnpm --filter @workspace/api-server build",
    "start:railway": "pnpm --filter @workspace/api-server start",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:push": "pnpm --filter @workspace/db push",
    "push:vapid": "pnpm --filter @workspace/api-server exec web-push generate-vapid-keys"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-unused-imports": "^4",
    "globals": "^15",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "js-cookie": "^3.0.7",
      "js-yaml": "^4.3.2",
      "ip-address": "^10.7.5",
      "body-parser": "^2.4.0",
      "@opentelemetry/core": "^2.8.0",
      "vite": "^7.3.7",
      "@babel/core": "^7.29.6",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "markdown-it": "^14.3.1",
      "linkify-it": "^5.0.2",
      "fast-uri": "^3.1.9",
      "postcss": "^8.5.23",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "proxy-addr": "^2.0.8",
      "esbuild": "^0.28.1",
      "source-map-js": "^1.2.2",
      "fast-copy": "^4.1.0",
      "postcss-selector-parser": "^7.1.6",
      "basic-ftp": "^6.2.1",
      "follow-redirects": "^1.16.2",
      "multer": "^2.5.0",
      "undici": "^7.30.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  }
}
