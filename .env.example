# Copy this file to .env.local for local development.
# The local starter can create/manage this Postgres container with Docker.
DATABASE_URL=postgres://trader:trader@127.0.0.1:5432/traderloadings
LOCAL_POSTGRES_PORT=55432
# Set to 0 for a local review without scheduled jobs. Production ignores this setting.
LOCAL_BACKGROUND_TASKS=1

BASE_PATH=/
PORT=3001
VITE_API_BASE=http://127.0.0.1:3001

# Optional integrations. Leave empty unless you are testing those flows.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# Webhook must subscribe: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.*, invoice.payment_succeeded/failed, charge.refunded,
# charge.dispute.created, account.updated
# Community marketplace (Stripe Connect direct charges) — dark until Connect enabled:
PLATFORM_FEE_BPS=0
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
REDIS_URL=
# Replay reads durable, single-source M1 history from PostgreSQL.
# Apply database migrations, then run pnpm backtest:sync (XAUUSD, EURUSD, USOIL).
CANDLE_WAREHOUSE=1
# start:local resumes missing history in a separate worker, then refreshes hourly.
# Set 0 to manage ingestion exclusively through CI or manual commands.
BACKTEST_HISTORY_SYNC=1
# Dedicated macro/probability collector. Apply 0036 before enabling; no training in API.
MACRO_INTELLIGENCE_COLLECTOR=0
# Reviewed Dukascopy session/holiday manifest; missing coverage causes abstention.
DIRECTIONAL_CALENDAR_PATH=
DIRECTIONAL_CALENDAR_SHA256=
# Offline candidates plus PAIR.validation.json. Each artifact needs its pinned hash.
DIRECTIONAL_MODEL_DIR=
DIRECTIONAL_MODEL_SHA256_EURUSD=
DIRECTIONAL_MODEL_SHA256_GBPUSD=
DIRECTIONAL_MODEL_SHA256_USDJPY=
DIRECTIONAL_MODEL_SHA256_USDCHF=
DIRECTIONAL_MODEL_SHA256_AUDUSD=
DIRECTIONAL_MODEL_SHA256_USDCAD=
DIRECTIONAL_MODEL_SHA256_NZDUSD=
DIRECTIONAL_MODEL_SHA256_XAUUSD=
# Myfxbook Community Outlook (retail long/short %). Without BOTH the Sentiment
# widget shows a static demo set. Account must have 2FA disabled.
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Transactional email (support tickets). Leave RESEND_API_KEY empty to disable
# sending — the app degrades gracefully (the ticket flow still works, no email is sent).
RESEND_API_KEY=
EMAIL_FROM=TraderLoading <assistenza@traderloading.com>
# Absolute origin used in email links + logo. Local dev points at the Vite app.
APP_BASE_URL=http://127.0.0.1:5173

# Academy: separate from Pro. Configure EUR 150/month, inclusive tax, licensed price.
STRIPE_ACADEMY_MONTHLY_PRICE_ID=
# Enable only after publishing real lessons and validating terms, tax and Stripe test flows.
ACADEMY_SALES_ENABLED=false

# LIMEN launch: only this existing admin account can edit/publish LIMEN training.
LIMEN_OWNER_USER_ID=
# Cloudflare Stream token stays server-side; customer host has no https:// prefix.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_HOST=
